{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "api",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "YAY_DEV_MODE=1",
        "services/.venv/bin/uvicorn", "yay_api.main:app",
        "--reload", "--reload-dir", "services", "--port", "8000", "--app-dir", "services"
      ],
      "port": 8000
    },
    {
      "name": "web",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "@yay/web", "dev"],
      "port": 5173
    }
  ]
}
